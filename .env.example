# Set false only for local demo mode. Shared Supabase data is used when this is true or unset.
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: used by scripts/create-demo-user.mjs — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Local-only NIIMBOT M2_H USB serial station worker.
# Set these on the printer laptop, not on the hosted master website.
# Use a Supabase access token for an authenticated app user.
LABEL_SERIAL_API_BASE_URL=http://localhost:3000
LABEL_SERIAL_AUTH_TOKEN=
LABEL_SERIAL_PORT=
LABEL_SERIAL_POLL_MS=3500

# Frictionless local print station mode.
# Keeps SUPABASE_SERVICE_ROLE_KEY server-only and bypasses auth only for print-job APIs.
PRINT_STATION_YOLO=false
NEXT_PUBLIC_PRINT_STATION_YOLO=false
PRINT_STATION_USER_ID=
